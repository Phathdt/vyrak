{
  "name": "vyrak",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@apps/api-server",
    "dev:worker": "turbo run dev --filter=@apps/worker",
    "dev:web": "turbo run dev --filter=@apps/web",
    "start": "turbo run start",
    "start:api": "turbo run start --filter=@apps/api-server",
    "start:worker": "turbo run start --filter=@apps/worker",
    "start:web": "turbo run start --filter=@apps/web",
    "build": "turbo run build",
    "build:prod": "turbo run build:prod",
    "generate:openapi": "yarn workspace @apps/api-server build && node dist/apps/api-server/generate-openapi.js",
    "generate:api": "yarn workspace @apps/web generate:api",
    "generate": "yarn generate:openapi && yarn generate:api && yarn db:generate",
    "test": "vitest run --config vitest.unit.config.mjs",
    "test:unit": "vitest run --config vitest.unit.config.mjs",
    "test:unit:watch": "vitest --config vitest.unit.config.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:integration:watch": "vitest --config vitest.integration.config.mjs",
    "test:ci": "vitest run --config vitest.unit.config.mjs --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --config oxlint.json apps libs --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\" --no-error-on-unmatched-pattern",
    "ci:lint": "oxlint --config oxlint.json apps libs --deny-warnings",
    "ci:format": "prettier --write",
    "ci:typecheck": "turbo run typecheck",
    "clean": "rm -rf dist .turbo node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "db:generate": "prisma generate --config=prisma/prisma.config.ts",
    "db:push": "prisma db push --config=prisma/prisma.config.ts",
    "db:migrate": "prisma generate --config=prisma/prisma.config.ts && prisma migrate dev --config=prisma/prisma.config.ts",
    "db:migrate:create": "prisma migrate dev --create-only --config=prisma/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config=prisma/prisma.config.ts",
    "db:status": "prisma migrate status --config=prisma/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "ctix": "node generate-indexes.js",
    "prepare": "lefthook install",
    "commit": "git-cz",
    "check:unused": "node unused-detector.js",
    "check:unused:ci": "node unused-detector.js --exit-code",
    "sync:deps": "npx ts-node scripts/sync-package-deps.ts",
    "sync:deps:dry": "npx ts-node scripts/sync-package-deps.ts --dry-run",
    "sync:deps:strict": "npx ts-node scripts/sync-package-deps.ts --strict --check-versions",
    "test:e2e": "yarn workspace @vyrak/e2e test",
    "test:e2e:headed": "yarn workspace @vyrak/e2e test:headed",
    "test:e2e:ui": "yarn workspace @vyrak/e2e test:ui",
    "db:seed:test": "tsx prisma/seed-test.ts",
    "workspace:list": "yarn workspace @apps/api-server cli workspace:list",
    "workspace:health": "yarn workspace @apps/api-server cli workspace:health",
    "workspace:clean-stale": "yarn workspace @apps/api-server cli workspace:clean-stale --org-id $ORG_ID --project-id $PROJECT_ID",
    "workspace:prune": "yarn workspace @apps/api-server cli workspace:prune --org-id $ORG_ID --project-id $PROJECT_ID"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testcontainers/postgresql": "^10",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "~26.6.5",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "bcryptjs": "^3.0.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^18.0.9",
    "dotenv-cli": "^11.0.0",
    "git-cz": "^4.9.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^25",
    "lefthook": "^2.2.2",
    "msw": "^2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "rolldown": "^1.2.15",
    "supertest": "^7.0.0",
    "testcontainers": "^10",
    "ts-node": "10.9.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^12.0.1",
    "@oxc-project/runtime": "^0.155.0",
    "argon2": "^0.45.1",
    "cache-manager": "^7.2.9"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.16.0",
    "yarn": ">=1.22.0"
  }
}
