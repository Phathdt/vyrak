# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE__URL=postgresql://postgres:postgres@localhost:5433/vyrak

# Redis (optional, for BullMQ worker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
JWT_EXPIRY=24h

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (MailCrab - Development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vyrak.local
