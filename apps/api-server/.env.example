# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE__URL=postgresql://postgres:postgres@localhost:5433/vyrak

# Redis (optional, for BullMQ worker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
JWT_EXPIRY=24h

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (MailCrab - Development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vyrak.local

# Workspace Configuration
# Workspace mode: only 'worktree' supported (fast, production-ready)
WORKSPACE_MODE=worktree

# Main repos path (required for worktree mode)
MAIN_REPOS_PATH=/var/vyrak/repos

# Workspaces path
WORKSPACES_PATH=/tmp/vyrak-workspaces

# Cleanup after workflow execution
WORKSPACE_CLEANUP_ON_SUCCESS=true
WORKSPACE_CLEANUP_ON_FAILURE=false

# Worktree-specific config
WORKTREE_BASE_BRANCH=main
WORKTREE_BRANCH_PREFIX=workflow/
WORKTREE_AUTO_FETCH=true
WORKTREE_AUTO_CLEANUP_BRANCH=true
