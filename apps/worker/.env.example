APP_ENV=local

# Application (Nest / tooling)
NODE_ENV=development

# CustomConfig: host.port. Worker serves GET /healthz on this port.
# local.yaml defaults to 3000 (shared with api-server), so the worker overrides it to 3100.
HOST__PORT=3100

# Database (required — local.yaml has database.url: replace_me)
DATABASE__URL=postgresql://postgres:postgres@localhost:5433/vyrak

# Redis URL (required — local.yaml has redis.url: replace_me)
REDIS__URL=redis://localhost:6379

# BullMQ queue connection (optional; defaults: localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT__SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
JWT__EXPIRY=24h

# Frontend CORS (top-level YAML key → FRONTEND_URL; FRONTEND__URL also works)
FRONTEND_URL=http://localhost:5173

# Email (MailCrab — development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vyrak.local

# Workspace (override replace_me / paths in local.yaml)
WORKSPACE__MODE=worktree
WORKSPACE__MAIN_REPOS_PATH=/var/vyrak/repos
WORKSPACE__WORKSPACES_PATH=/tmp/vyrak-workspaces
WORKSPACE__CLEANUP_ON_SUCCESS=true
WORKSPACE__CLEANUP_ON_FAILURE=false
WORKSPACE__WORKTREE__BASE_BRANCH=main
WORKSPACE__WORKTREE__BRANCH_PREFIX=workflow/
WORKSPACE__WORKTREE__AUTO_FETCH=true
WORKSPACE__WORKTREE__AUTO_CLEANUP_BRANCH=true

# Agent runtime
AGENT_RUNTIME__USE_FAKE_AGENT=false
AGENT_RUNTIME__CLAUDE_CLI_PATH=claude

# S3 / Floci (local dev). Use real AWS values in production.
S3__ENDPOINT=http://localhost:4566
S3__REGION=us-east-1
S3__BUCKET=vyrak-artifacts
S3__ACCESS_KEY_ID=test
S3__SECRET_ACCESS_KEY=test
S3__FORCE_PATH_STYLE=true

# Anthropic — optional for API startup; required for brainstorming / AI endpoints
# Uses @anthropic-ai/sdk (Messages API). Proxy must speak Anthropic API, not OpenAI /v1/chat/completions.
ANTHROPIC__API_KEY=sk-ant-your-key-here
ANTHROPIC__MODEL=my-opus
# Custom base URL without /v1 (app appends /v1). Omit for api.anthropic.com
ANTHROPIC__API_URL=http://localhost:20128
# Auth header: x-api-key (default, Anthropic) | bearer (Authorization: Bearer <API_KEY>)
ANTHROPIC__AUTH_SCHEME=bearer
