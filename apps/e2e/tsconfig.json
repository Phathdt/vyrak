{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "types": ["node", "@playwright/test"],
    "paths": {
      "@config/*": ["./config/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@helpers/*": ["./helpers/*"],
      "@page-objects/*": ["./page-objects/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
