datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../libs/database/src/generated/prisma"
  moduleFormat = "commonjs"
}

// User Model - JWT Authentication
model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  passwordHash  String?  @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  members      Member[]
  auditLogs    AuditLog[]
  workflowRuns WorkflowRun[]

  @@map("user")
}

// Organization Models
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members           Member[]
  invitations       Invitation[]
  projects          Project[]
  gitRepositories   GitRepository[]
  workflowRuns      WorkflowRun[]
  workflowStepRuns  WorkflowStepRun[]
  workflowEvents    WorkflowEvent[]
  workflowApprovals WorkflowApproval[]
  agentTasks        AgentTask[]
  artifacts         Artifact[]
  auditLogs         AuditLog[]

  @@map("organizations")
}

model Member {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  role           String
  status         String   @default("pending")
  inviterId      String   @map("inviter_id")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
  @@map("invitation")
}

// Multi-Tenancy Business Models
model Project {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gitRepositories GitRepository[]
  workflowRuns    WorkflowRun[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

model GitRepository {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  organizationId String   @map("organization_id")
  name           String
  url            String
  branch         String   @default("main")
  provider       String   @default("github") // github, gitlab, bitbucket
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
  @@map("git_repositories")
}

model WorkflowTemplate {
  id                   String   @id @default(uuid())
  key                  String   @unique @db.VarChar(50)
  name                 String   @db.VarChar(100)
  description          String   @db.Text
  icon                 String   @db.VarChar(10)
  isActive             Boolean  @default(true) @map("is_active")
  storyBased           Boolean  @default(true) @map("story_based")
  phases               Json
  estimatedDurationMin Int?     @map("estimated_duration_min")
  estimatedDurationMax Int?     @map("estimated_duration_max")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workflowRuns WorkflowRun[]

  @@index([key])
  @@index([isActive])
  @@map("workflow_templates")
}

model WorkflowRun {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  organizationId     String    @map("organization_id")
  templateId         String?   @map("template_id")
  templateKey        String?   @map("template_key") @db.VarChar(50)
  status             String    @default("pending")
  state              String    @default("pending") // pending, running, waiting_approval, completed, failed, cancelled
  workflowKey        String    @map("workflow_key")
  workflowVersion    String    @map("workflow_version")
  initiatedByUserId  String    @map("initiated_by_user_id")
  idempotencyKey     String?   @map("idempotency_key")
  input              Json?
  currentStepKey     String?   @map("current_step_key")
  totalStories       Int       @default(0) @map("total_stories")
  completedStories   Int       @default(0) @map("completed_stories")
  failedStories      Int       @default(0) @map("failed_stories")
  currentStoryId     String?   @map("current_story_id")
  cancelRequestedAt  DateTime? @map("cancel_requested_at")
  cancellationReason String?   @map("cancellation_reason") @db.Text
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  cancelledAt        DateTime? @map("cancelled_at")
  errorCode          String?   @map("error_code")
  errorMessage       String?   @map("error_message") @db.Text
  result             String?   @db.Text
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  leaseOwnerId       String?   @map("lease_owner_id")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  lastHeartbeatAt    DateTime? @map("last_heartbeat_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiatedBy  User               @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  template     WorkflowTemplate?  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  agentTasks   AgentTask[]
  artifacts    Artifact[]
  steps        WorkflowStepRun[]
  events       WorkflowEvent[]
  approvals    WorkflowApproval[]
  stories      Story[]

  @@unique([organizationId, idempotencyKey], map: "workflow_runs_org_idempotency_key")
  @@index([projectId])
  @@index([organizationId])
  @@index([status])
  @@index([state])
  @@index([initiatedByUserId])
  @@index([leaseExpiresAt])
  @@index([lastHeartbeatAt])
  @@index([templateId])
  @@index([currentStoryId])
  @@map("workflow_runs")
}

model AgentTask {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  organizationId String   @map("organization_id")
  taskType       String   @map("task_type")
  status         String   @default("pending")
  input          String?  @db.Text
  output         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  run          WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([organizationId])
  @@map("agent_tasks")
}

model Artifact {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  organizationId String   @map("organization_id")
  filePath       String   @map("file_path")
  s3Bucket       String   @map("s3_bucket")
  s3Key          String   @map("s3_key")
  contentSize    Int      @map("content_size")
  contentType    String   @default("text/plain") @map("content_type")
  createdAt      DateTime @default(now()) @map("created_at")

  run          WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([organizationId])
  @@map("artifacts")
}

model Story {
  id                 String    @id @default(uuid())
  workflowRunId      String    @map("workflow_run_id")
  orderIndex         Int       @map("order_index")
  title              String    @db.VarChar(255)
  description        String?   @db.Text
  acceptanceCriteria Json?     @map("acceptance_criteria")
  estimatedDuration  Int?      @map("estimated_duration")
  status             String    @default("queued") @db.VarChar(50)
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  duration           Int?
  error              String?   @db.Text
  artifacts          Json?
  subSteps           Json?     @map("sub_steps")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, orderIndex], map: "unique_story_order")
  @@index([workflowRunId])
  @@index([status])
  @@index([workflowRunId, orderIndex])
  @@map("stories")
}

model WorkflowStepRun {
  id                String    @id @default(uuid())
  runId             String    @map("run_id")
  organizationId    String    @map("organization_id")
  stepKey           String    @map("step_key")
  phaseKey          String?   @map("phase_key") @db.VarChar(50)
  stepType          String    @map("step_type")
  status            String    @default("pending")
  attempt           Int       @default(1)
  requiresApproval  Boolean   @default(false) @map("requires_approval")
  currentStoryId    String?   @map("current_story_id")
  completedStoryIds Json      @default("[]") @map("completed_story_ids")
  input             Json?
  output            Json?
  errorCode         String?   @map("error_code")
  errorMessage      String?   @map("error_message") @db.Text
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  run          WorkflowRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       WorkflowEvent[]

  @@unique([runId, stepKey, attempt])
  @@index([runId])
  @@index([organizationId])
  @@index([status])
  @@index([phaseKey])
  @@map("workflow_step_runs")
}

model WorkflowEvent {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  organizationId String   @map("organization_id")
  stepRunId      String?  @map("step_run_id")
  sequence       Int
  eventType      String   @map("event_type")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  run          WorkflowRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stepRun      WorkflowStepRun? @relation(fields: [stepRunId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId])
  @@index([organizationId])
  @@index([eventType])
  @@index([createdAt])
  @@map("workflow_events")
}

model WorkflowApproval {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  workflowRunId      String    @unique @map("workflow_run_id")
  status             String    @default("pending") // pending, approved, rejected
  planArtifactId     String    @map("plan_artifact_id")
  planArtifactHash   String    @map("plan_artifact_hash")
  decidedByUserId    String?   @map("decided_by_user_id")
  decidedAt          DateTime? @map("decided_at")
  comment            String?   @db.Text
  invalidatedAt      DateTime? @map("invalidated_at")
  invalidationReason String?   @map("invalidation_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowRun  WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowRunId])
  @@index([status])
  @@index([createdAt])
  @@map("workflow_approvals")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  event          String // auth.login, organization.created, member.invited, etc.
  action         String // create, update, delete, read
  resource       String // organization, member, project, workflow
  resourceId     String?  @map("resource_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}
