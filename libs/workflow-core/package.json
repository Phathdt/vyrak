{
  "name": "@vyrak/workflow-core",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rolldown -c && tsc --emitDeclarationOnly",
    "dev": "rolldown -c --watch",
    "test": "vitest run --exclude '**/*.integration.spec.ts' --exclude '**/__tests__/integration/**'",
    "test:unit": "vitest run --exclude '**/*.integration.spec.ts' --exclude '**/__tests__/integration/**'",
    "test:unit:watch": "vitest --exclude '**/*.integration.spec.ts' --exclude '**/__tests__/integration/**'",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:integration:watch": "vitest --config vitest.integration.config.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@vyrak/agent-runtime": "*",
    "@vyrak/database": "*",
    "bullmq": "^6.4.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "bullmq": "^6.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@nestjs/testing": "^12.2.0",
    "@types/node": "~26.6.5",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
