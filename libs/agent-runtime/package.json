{
  "name": "@vyrak/agent-runtime",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rolldown -c && tsc --emitDeclarationOnly",
    "dev": "rolldown -c --watch",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.spec.ts'",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vyrak/database": "*",
    "nestjs-zod": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
