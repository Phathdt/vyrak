model ConversationSession {
  id         String   @id @default(cuid())
  workflowId String
  phase      String // BRAINSTORMING | PLANNING | IMPLEMENTATION | etc.
  status     String // ACTIVE | COMPLETED | ARCHIVED
  metadata   Json?
  startedAt  DateTime @default(now())
  endedAt    DateTime?

  workflow Workflow              @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([workflowId, phase])
  @@index([workflowId, status])
  @@map("conversation_sessions")
}

model ConversationMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user | assistant | system
  content   String   @db.Text
  metadata  Json? // tokens, model, timestamp, etc.
  createdAt DateTime @default(now())

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("conversation_messages")
}
