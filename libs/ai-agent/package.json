  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@nestjs/common": "^11",
    "@nestjs/config": "^3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~6.0.2"
  }
}
