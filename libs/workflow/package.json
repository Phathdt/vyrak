{
  "name": "@vyrak/workflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && rolldown --config rolldown.config.mjs",
    "dev": "tsc && rolldown --config rolldown.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vyrak/database": "*",
    "nestjs-zod": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/swagger": "^12.0.4"
  }
}
