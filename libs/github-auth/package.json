    "@octokit/auth-app": "^7.1.3",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "~26.6.6",
    "ioredis-mock": "^8.9.0",
    "rolldown": "^1.3.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
