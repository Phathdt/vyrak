{
  "name": "@vyrak/artifact",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && rolldown -c rolldown.config.mjs",
    "dev": "tsc && rolldown -c rolldown.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vyrak/custom-config": "workspace:*",
    "@vyrak/database": "workspace:*",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@opentelemetry/api": "^1.10.0",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.3",
    "@types/node": "~26.6.6",
    "rolldown": "^1.3.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
